# Copy this file to .env and fill in real values before running.
# NEVER commit the real .env file to version control.

# Server
PORT=4000
NODE_ENV=production

# Auth secrets - generate strong random values, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS - the exact origin(s) allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Database
DB_PATH=./data/school.db

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# Initial admin account (used only by the seed script)
SEED_ADMIN_EMAIL=admin@school.test
SEED_ADMIN_PASSWORD=ChangeMe!2026
